# Tandem config. Copy to .env and fill in. .env is gitignored.

# --- Realtime mode (recommended: one key) ---
TANDEM_VOICE=realtime
OPENAI_API_KEY=sk-proj-...
TANDEM_OWNER=Your Name

# Optional realtime tuning
# TANDEM_REALTIME_MODEL=gpt-realtime-2.1-mini
# TANDEM_REALTIME_VOICE=marin
# TANDEM_REALTIME_EFFORT=low

# Override Chrome location if auto-detect fails
# CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe

# --- Classic pipeline (only without TANDEM_VOICE=realtime) ---
# DEEPGRAM_API_KEY=
# GROQ_API_KEY=
# TOGETHER_API_KEY=
